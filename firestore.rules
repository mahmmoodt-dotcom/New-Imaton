
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPER FUNCTIONS ---
    
    function isString(val) { return val is string; }
    function isNumber(val) { return val is number; }
    function isList(val) { return val is list; }
    function isMap(val) { return val is map; }

    function validateOrder(data) {
      return isString(data.id) &&
             isString(data.customerName) &&
             isString(data.phoneNumber) &&
             isString(data.city) &&
             isString(data.address) &&
             isNumber(data.totalAmount) &&
             isList(data.items) &&
             data.items.size() > 0;
    }

    function validateProduct(data) {
      return isString(data.id) &&
             isMap(data.name) &&
             isNumber(data.price) &&
             isString(data.categoryId);
    }

    function validateCategory(data) {
      return isString(data.id) &&
             isMap(data.name) &&
             isString(data.image);
    }

    // --- COLLECTION RULES ---

    // Products & Categories: Publicly readable for the shop catalog
    match /products/{productId} {
      allow read: if true;
      allow write: if false; // All modifications MUST go through the Secure Server (Admin SDK)
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false; // All modifications MUST go through the Secure Server (Admin SDK)
    }

    // Orders: Readable for tracking, but only writable on creation
    match /orders/{orderId} {
      allow read: if true;
      // Allow creation with schema validation. 
      // Note: In this architecture, creation is handled by the server to manage atomic counters.
      // This rule acts as a secondary layer of documentation and future-proofing.
      allow create: if validateOrder(request.resource.data);
      allow update, delete: if false; 
    }

    // Configuration & Metadata
    match /config/{configId} {
      allow read: if true;
      allow write: if false; // Settings are managed via the Admin Panel (Server-side)
    }

    match /metadata/{metaId} {
      allow read: if true;
      allow write: if false; // Counters are atomic and server-managed
    }

    // Default catch-all
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
