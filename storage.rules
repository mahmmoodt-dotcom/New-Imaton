
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Public Assets (Products, Categories, Branding)
    match /shop/{allPaths=**} {
      // Allow anyone to view the assets
      allow read: if true;
      
      // All writes (Upload/Delete/Update) are restricted to the Admin SDK on our server.
      // This prevents direct client-side binary injection or unauthorized modification.
      allow write: if false;
    }

    // General fallback
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
