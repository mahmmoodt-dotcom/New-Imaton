# Imation — Hostinger (Apache)

# No directory listings anywhere — uploads/ would otherwise show every photo.
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Send everyone to https. The admin session cookie is marked `secure`, so
  # over plain http an admin simply could not stay signed in — and a
  # customer's name, phone and address would cross the network in clear.
  # Turn the SSL certificate on in hPanel BEFORE uploading this file.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Nothing under a .git checkout or the local-dev database folder is ever
  # served, even if it is uploaded by mistake.
  RewriteRule ^(\.git|server/data)(/|$) - [F,L]

  # lib/ is included by the endpoints in api/, never requested directly.
  # PHP executes it rather than printing it, so this leaks nothing today —
  # it is here so a future server without PHP enabled cannot serve it as text.
  RewriteRule ^lib/ - [F,L]

  # Uploaded files are images only; a script extension under /uploads is
  # refused outright, whatever the upload check decided.
  RewriteRule ^uploads/.*\.(php|phtml|phar|pl|py|cgi|sh)(\.|$) - [F,L,NC]

  # Never rewrite the API or uploaded files.
  RewriteCond %{REQUEST_URI} ^/(api|uploads)/ [OR]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # The app uses hash-based routing (#/shop, #/admin, ...), so the browser
  # never asks the server for those paths — but a stray direct request for
  # anything else still gets the app shell instead of a bare Apache 404.
  RewriteRule ^ index.html [L]
</IfModule>

# Never serve server-side files, even if they are placed in the web root:
# the config (database password), any SQL or SQLite database file, and the
# local-dev helper scripts.
<FilesMatch "^(config(\.example)?\.php|local-sqlite-init\.php|router\.php)$|\.(sql|sqlite|sqlite3|db)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # Content Security Policy: the browser refuses to run any script that did
  # not come from this site, so a script smuggled into a product name or a
  # review could not execute. Everything the site genuinely needs is listed.
  #
  #   script-src 'self'          only our own bundle runs
  #   object-src 'none'          no Flash/embeds
  #   frame-ancestors 'self'     nobody can frame the admin panel
  #   style 'unsafe-inline'      React writes inline style="" attributes
  #   img https: data:           product photos may be hosted anywhere
  #   frame-src google maps      the About page embeds a map
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self'; frame-src https://www.google.com https://maps.google.com; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'"

  # Hide what software and version is running — free information for anyone
  # scanning for a known vulnerability.
  Header always unset X-Powered-By
  Header unset X-Powered-By

  # Turn this on ONLY once https://yourdomain.com is confirmed working with
  # the SSL certificate from hPanel. It tells browsers to refuse plain http
  # for a year, so enabling it while https is broken locks visitors out.
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

<IfModule mod_php.c>
  php_flag expose_php off
</IfModule>
ServerSignature Off

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 month"
  ExpiresByType image/png               "access plus 1 month"
  ExpiresByType image/webp              "access plus 1 month"
  ExpiresByType image/svg+xml           "access plus 1 month"
  # The HTML shell must always be revalidated, or updates never reach anyone.
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>
